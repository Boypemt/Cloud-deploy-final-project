# Copy this file to .env for local development (never commit .env).
PORT=3003
MONGO_URI=mongodb://127.0.0.1:27017/campusmart_orders
# MUST be the same value in auth-service, product-service and order-service
JWT_SECRET=dev-only-secret-change-me
# Where product-service is reachable (docker-compose / k8s: http://product-service:3002)
PRODUCT_SERVICE_URL=http://localhost:3002
# Shared secret between order-service and product-service for PATCH /api/products/:id/stock
INTERNAL_API_KEY=dev-internal-key
DNS_SERVERS=
