# Copy this file to .env for local development (never commit .env).
PORT=3001
# Local Mongo (docker run -d -p 27017:27017 mongo:7) or your MongoDB Atlas connection string
MONGO_URI=mongodb://localhost:27017/campusmart_auth
# MUST be the same value in auth-service, product-service and order-service
JWT_SECRET=dev-only-secret-change-me
JWT_EXPIRES_IN=1h
# Seeded on start-up if they do not exist yet (see API_CONTRACT.md)
ADMIN_EMAIL=admin@campusmart.local
ADMIN_PASSWORD=Admin@1234
DEMO_EMAIL=demo@campusmart.local
DEMO_PASSWORD=Demo@1234
# Optional: only if MongoDB Atlas SRV lookup fails on your network (e.g. 1.1.1.1,8.8.8.8)
DNS_SERVERS=
